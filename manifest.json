{
  "manifest_version": 3,
  "name": "AI MVP Scope Checker",
  "version": "0.1.0",
  "description": "A lightweight checklist that helps founders sanity-check an AI MVP scope before build.",
  "action": {
    "default_title": "AI MVP Scope Checker",
    "default_popup": "popup.html"
  },
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["<all_urls>"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
